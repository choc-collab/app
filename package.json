{
  "name": "choc-collab",
  "version": "0.6.0",
  "description": "A chocolatier's toolkit — manage products, fillings, ingredients, moulds, and production plans. Local-first, runs entirely in the browser.",
  "author": "Choc-collab contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/choc-collab/choc-collab.git"
  },
  "keywords": [
    "chocolatier",
    "chocolate",
    "production",
    "recipe-management",
    "ganache",
    "local-first",
    "pwa",
    "nextjs",
    "indexeddb"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:prod": "next build && playwright test --config=playwright.prod.config.ts",
    "docs:screenshots": "PLAYWRIGHT_DOCS=1 playwright test e2e/docs-screenshots.spec.ts",
    "audit": "npm audit --audit-level=moderate"
  },
  "type": "module",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/leaflet": "^1.9.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.3",
    "dexie-cloud-addon": "^4.4.13",
    "dexie-react-hooks": "^4.4.0",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.17.0",
    "next": "^16.2.7",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "svg2pdf.js": "^2.7.0",
    "tailwind-merge": "^3.6.0"
  },
  "overrides": {
    "postcss": "^8.5.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.7",
    "postcss": "^8.5.13",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
